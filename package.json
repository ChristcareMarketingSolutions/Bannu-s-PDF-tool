{
  "name": "bannus-pdf-tool",
  "version": "1.1.0",
  "private": true,
  "description": "Bannu's PDF Tool — client-side PDF toolkit (static site for GitHub Pages)",
  "scripts": {
    "build": "esbuild js/app.js --bundle --format=iife --target=es2020 --minify --legal-comments=none --outfile=js/app.bundle.js",
    "watch": "esbuild js/app.js --bundle --format=iife --target=es2020 --sourcemap --outfile=js/app.bundle.js --watch",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
